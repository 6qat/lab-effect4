{
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"types": ["node", "bun"],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"plugins": [{ "name": "@effect/language-service" }]
	}
}

{
	"name": "scid-viewer",
	"displayName": "SCID Data Viewer",
	"description": "VS Code extension to visualize binary Sierra Chart Intraday Data (.scid) files",
	"version": "0.1.0",
	"publisher": "6qat",
	"private": true,
	"type": "module",
	"engines": {
		"vscode": "^1.90.0"
	},
	"main": "./dist/extension.cjs",
	"activationEvents": [
		"onCustomEditor:scidViewer.editor",
		"onView:scidExplorer"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "scid-explorer-container",
					"title": "SCID Explorer",
					"icon": "$(database)"
				}
			]
		},
		"views": {
			"scid-explorer-container": [
				{
					"id": "scidExplorer",
					"name": "Market Data Files"
				}
			]
		},
		"commands": [
			{
				"command": "scidExplorer.refresh",
				"title": "Refresh Market Data",
				"icon": "$(refresh)"
			},
			{
				"command": "scidExplorer.openFile",
				"title": "Open SCID File"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "scidExplorer.refresh",
					"when": "view == scidExplorer",
					"group": "navigation"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "scidViewer.editor",
				"displayName": "SCID Data Viewer",
				"selector": [
					{
						"filenamePattern": "*.scid"
					}
				],
				"priority": "default"
			}
		]
	},
	"scripts": {
		"build": "bun esbuild.config.mjs",
		"package": "bun esbuild.config.mjs && bun x @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --skip-license",
		"test": "bun test ./src",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "biome format --write ./src && biome check --write ./src",
		"format:check": "biome format ./src",
		"lint": "biome lint ."
	},
	"dependencies": {
		"effect": "4.0.1",
		"tcp": "workspace:*"
	},
	"devDependencies": {
		"@types/vscode": "~1.90.0",
		"esbuild": "^0.28.2"
	}
}

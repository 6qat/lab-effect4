      "preview": {
        "sourceText": "import { Effect } from \"effect\"\n\nexport const preview = Effect.succeed(1).pipe(\n  Effect.map(() => undefined)\n)\n",
        "diagnostics": [
          {
            "start": 82,
            "end": 92,
            "text": "This expression discards the success value through mapping. `Effect.asVoid` represents that form directly.    effect(effectMapVoid)"
          }
        ]
      }
    },
    {
      "name": "effectSucceedWithVoid",
      "group": "style",
      "description": "Suggests using Effect.void instead of Effect.succeed(undefined) or Effect.succeed(void 0)",
      "defaultSeverity": "suggestion",
      "fixable": true,
      "supportedEffect": [
        "v3",
        "v4"
      ],
      "preview": {
        "sourceText": "import { Effect } from \"effect\"\n\nexport const preview = Effect.succeed(undefined)\n",
        "diagnostics": [
          {
            "start": 56,
            "end": 81,
            "text": "`Effect.void` represents the same outcome as `Effect.succeed(undefined)` or `Effect.succeed(void 0)`.    effect(effectSucceedWithVoid)"
          }
        ]
      }
    },
    {
      "name": "flatMapToMap",
      "group": "style",
      "description": "Suggests using Effect.map instead of Effect.flatMap when the callback only wraps its result with Effect.succeed",
      "defaultSeverity": "suggestion",
      "fixable": true,
      "supportedEffect": [
        "v3",
        "v4"
      ],
      "preview": {
        "sourceText": "import { Effect } from \"effect\"\n\nconst program = Effect.succeed(1).pipe(\n  Effect.flatMap((value) => Effect.succeed(value + 1))\n)\n",
        "diagnostics": [
          {
            "start": 75,
            "end": 89,
            "text": "`Effect.map` expresses this success-value transformation more directly than `Effect.flatMap` followed by `Effect.succeed`.    effect(flatMapToMap)"
          }
        ]
      }
    },
    {
      "name": "importFromBarrel",
      "group": "style",
      "description": "Suggests importing from specific module paths instead of barrel exports",
      "defaultSeverity": "off",
      "fixable": true,
      "supportedEffect": [

          }
        ]
      }
    },
    {
      "name": "schemaUnionOfLiterals",
      "group": "style",
      "description": "Simplifies Schema.Union of multiple Schema.Literal calls into single Schema.Literal",
      "defaultSeverity": "off",
      "fixable": true,
      "supportedEffect": [
        "v3"
      ],
      "preview": {
        "sourceText": "import * as Schema from \"effect/Schema\"\n\nexport const preview = Schema.Union(Schema.Literal(\"a\"), Schema.Literal(\"b\"))\n",
        "diagnostics": [
          {
            "start": 64,
            "end": 118,
            "text": "This `Schema.Union` contains multiple `Schema.Literal` members and can be simplified to a single `Schema.Literal` call.    effect(schemaUnionOfLiterals)"
          }
        ]
      }
    },
    {
      "name": "serviceNotAsClass",
      "group": "style",
      "description": "Warns when Context.Service is used as a variable instead of a class declaration",
      "defaultSeverity": "off",
      "fixable": true,
      "supportedEffect": [
        "v4"
      ],
      "preview": {
        "sourceText": "import { Context } from \"effect\"\n\nexport const Preview = Context.Service<{ port: number }>(\"Preview\")\n",
        "diagnostics": [
          {
            "start": 57,
            "end": 101,
            "text": "`Context.Service` is assigned to a variable here, but this API is intended for a class declaration shape such as `class Preview extends Context.Service<Preview, { port: number }>()(\"Preview\") {}`.    effect(serviceNotAsClass)"
          }
        ]
      }
    },
    {
      "name": "strictBooleanExpressions",
      "group": "style",
      "description": "Enforces boolean types in conditional expressions for type safety",
      "defaultSeverity": "off",
      "fixable": false,
      "supportedEffect": [
        "v3",
        "v4"
      ],
      "preview": {
